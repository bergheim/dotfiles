profile mobile {
    output eDP-1 enable mode preferred scale 2
}

profile hdmi {
    output HDMI-A-1 enable mode preferred
    output eDP-1 enable mode preferred scale 2
    exec $HOME/local/bin/display-mode arrange
}

profile docked {
    output DP-2 enable mode preferred scale 2
    output eDP-1 enable mode preferred scale 2
    exec $HOME/local/bin/display-mode arrange
    exec $HOME/.config/kanshi/docked.sh
}

profile berghome {
    output DP-1 enable mode preferred scale 2 position 0,0
    output DP-2 enable mode preferred scale 2 transform 270 position 1920,0
}
