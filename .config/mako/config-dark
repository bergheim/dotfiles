# Mako — DARK theme (mirrors waybar/style-dark.css palette).
# See config-light for the theme-switching pattern notes.
output=DP-1
default-timeout=15000
max-visible=-1
max-history=50
width=500
height=400
border-radius=6
border-size=2
padding=10
margin=10
font=JetBrains Mono 10
on-button-right=exec mako-actions "$id"

background-color=#0a0f14e6
text-color=#ecf0f1
border-color=#086608
progress-color=over #2c3e50

[urgency=low]
border-color=#2c3e50

[urgency=normal]
border-color=#086608

[urgency=high]
background-color=#8b0000e6
text-color=#ecf0f1
border-color=#8b0000
default-timeout=0

# Suppress Android's duplicate Phone-app mirror. Keep KDE Connect's
# call-start telephony notification visible so caller ID is shown.
[app-name="KDE Connect" summary="Phone"]
invisible=1
