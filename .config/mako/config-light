# Mako — LIGHT theme (mirrors waybar/style-light.css palette).
# NOTE: mako has no @import mechanism, so this file must contain the
# full config. The runtime `config` symlink points here or at
# `config-dark` depending on current appearance (see toggle-darkmode).
# `output=` is machine-specific — adjust per host.
output=DP-1
default-timeout=15000
max-visible=-1
max-history=50
width=500
height=400
border-radius=6
border-size=2
padding=10
margin=10
font=JetBrains Mono 10
on-button-right=exec mako-actions "$id"

background-color=#ebebdbe6
text-color=#2c3e50
border-color=#c0df6f
progress-color=over #98d1ce

[urgency=low]
border-color=#98d1ce

[urgency=normal]
border-color=#c0df6f

[urgency=high]
background-color=#950f0fe6
text-color=#ebebdb
border-color=#950f0f
default-timeout=0

# Android Phone app mirror — telephony plugin owns call actions.
[app-name="KDE Connect" summary="Phone"]
invisible=1

[app-icon=call-start]
invisible=1
