[Unit]
Description=Emacs text editor
Documentation=info:emacs man:emacs(1) https://gnu.org/software/emacs/
# Start only after the Sway session has imported WAYLAND_DISPLAY into the
# systemd user env, otherwise the daemon comes up display-less and every GUI
# app it spawns (browse-url -> firefox, xdg-open, pinentry) has no display.
After=sway-session.target
PartOf=sway-session.target

[Service]
# Type=notify
Type=simple
Environment=NODE_VERSION=default
ExecStart=%h/local/bin/emacs-daemon-start
ExecStop=emacsclient --eval "(kill-emacs)"

# Emacs will exit with status 15 after having received SIGTERM, which
# is the default "KillSignal" value systemd uses to stop services.
SuccessExitStatus=15

# The location of the SSH auth socket varies by distribution, and some
# set it from PAM, so don't override by default.
Environment=SSH_AUTH_SOCK=%t/keyring/ssh
Restart=on-failure

[Install]
WantedBy=sway-session.target
