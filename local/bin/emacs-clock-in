#!/usr/bin/env sh

tasks=$(emacsclient -e "(bergheim/org-get-tasks-for-rofi)" | sed 's/^"\|"$//g')
selection=$(printf '%b\n' "$tasks" | fuzzel --dmenu --prompt ' clock in ') || exit 0
[ -n "$selection" ] || exit 0
title=$(jq -n --arg t "$selection" '$t')
emacsclient -e "(bergheim/org-clock-in-from-rofi $title)"
