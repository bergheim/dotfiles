#!/bin/sh
# Desktop-meaningful actions on a mako notification.
# Drops Android "open the app on the phone" verbs on KDE Connect only.
# Remind is always offered (any notification). Default: org-capture frame.
# Override with MAKO_REMIND_CMD (sees MAKO_APP MAKO_SUMMARY MAKO_BODY MAKO_REMIND_TEXT).
id=$1
json=$(makoctl list -j) || exit 0
if [ -z "$id" ]; then
	id=$(printf '%s' "$json" | jq -r '.[0].id // empty')
fi
[ -n "$id" ] || exit 0

notif=$(printf '%s' "$json" | jq -c --arg id "$id" '.[] | select((.id | tostring) == $id)')
[ -n "$notif" ] || exit 0

app=$(printf '%s' "$notif" | jq -r '.app_name // empty')
# KDE Connect: drop phone "open the app" unless this looks like mail (has Archive).
# Order: Open, Archive, other, Delete. Remind is appended last.
choices=$(printf '%s' "$notif" | jq -r --arg app "$app" '
	(.actions // {}) as $a
	| ($app | test("kde connect"; "i")) as $kde
	| ($a | to_entries | any(.value | test("^archive$"; "i"))) as $mail
	| $a | to_entries
	| map(. + {rank: (
		.value | ascii_downcase
		| if test("^open$") then 0
		  elif test("^archive$") then 1
		  elif test("^delete$") then 3
		  else 2 end)})
	| sort_by(.rank)
	| .[]
	| select($mail or ($kde | not) or (.value | test("^(view|open|open app|show|vis|åpne)$"; "i") | not))
	| "\(.key)\t\(.value)"
')
code=$(printf '%s' "$notif" | jq -r '"\(.summary // "")\n\(.body // "")"' | otpgrep) || code=
[ -n "$code" ] && choices=$(printf 'otp-copy\tCopy code %s%s' "$code" "${choices:+
$choices}")

choices=$(printf '%s%s\n' "${choices:+$choices
}" 'mako-remind	Remind')

# Nerd Font glyphs rather than Rofi's dmenu icon protocol: fuzzel already
# renders JetBrains Mono Nerd Font, and a themed icon name (mail-archive)
# is missing often enough to leave rows unevenly indented.
# --index avoids matching the selection back by label text.
icon_for() {
	case $1 in
	otp-copy)
		printf '\uf0c5'
		return
		;;
	mako-remind)
		printf '\uf0f3'
		return
		;;
	esac
	case $(printf '%s' "$2" | tr '[:upper:]' '[:lower:]') in
	open | view | show | vis | åpne) printf '\uf0e0' ;;
	archive) printf '\uf187' ;;
	delete) printf '\uf1f8' ;;
	mute) printf '\uf026' ;;
	call) printf '\uf095' ;;
	message) printf '\uf075' ;;
	*) printf '\uf05a' ;;
	esac
}

tab=$(printf '\t')
index=$(printf '%s\n' "$choices" | while IFS="$tab" read -r k v; do
	printf '%s  %s\n' "$(icon_for "$k" "$v")" "$v"
done | fuzzel --no-sort --index -d -p 'Action:') || exit 0
[ -n "$index" ] || exit 0
key=$(printf '%s\n' "$choices" | awk -F'\t' -v i="$index" 'NR == i + 1 { print $1; exit }')
[ -n "$key" ] || exit 0

if [ "$key" = otp-copy ]; then
	printf '%s' "$code" | wl-copy
	makoctl dismiss -n "$id"
	exit 0
fi

if [ "$key" = mako-remind ]; then
	app=$(printf '%s' "$notif" | jq -r '.app_name // empty')
	summary=$(printf '%s' "$notif" | jq -r '.summary // empty')
	body=$(printf '%s' "$notif" | jq -r '.body // empty')
	# FDO bodies are often HTML (Dino, etc). Strip here, not in mako/kdeconnect.
	# Title → heading, body → %i (same shape as email-follow-up.org).
	keys=${MAKO_REMIND_KEYS:-pr}
	sexp=$(python3 -c '
import html, json, re, sys
def plain(s):
    s = html.unescape(s or "")
    s = re.sub(r"(?i)<br\\s*/?>", "\n", s)
    s = re.sub(r"(?i)</p>\\s*", "\n", s)
    s = re.sub(r"<[^>]+>", "", s)
    return re.sub(r"\n{3,}", "\n\n", s).strip()
app, summary, body, keys = sys.argv[1:5]
app, summary, body = plain(app), plain(summary), plain(body)
title = f"{app}: {summary}" if app and summary else (app or summary)
title = " ".join(title.split())
print("(progn (setq bergheim/capture-heading %s) (bergheim/capture %s %s))" % (
    json.dumps(title, ensure_ascii=False),
    json.dumps(body, ensure_ascii=False),
    json.dumps(keys)))
' "$app" "$summary" "$body" "$keys")
	if [ -n "$MAKO_REMIND_CMD" ]; then
		MAKO_APP=$app MAKO_SUMMARY=$summary MAKO_BODY=$body \
			exec sh -c "$MAKO_REMIND_CMD"
	fi
	# title contains "floating": sway/niri/hypr for_window.
	emacsclient -c -F '((name . "floating"))' --eval "$sexp" && makoctl dismiss -n "$id"
fi

makoctl invoke -n "$id" "$key"
makoctl dismiss -n "$id"
