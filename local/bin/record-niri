#!/bin/sh
# Screencast recorder for niri. Records via wf-recorder, then transcodes to
# AV1 .webm for sharing (browser seekbar).
#
# Usage:
#   record-niri                # region (slurp), scp + URL
#   record-niri full|window    # focused output / window
#   record-niri --local …      # no scp; ID--title__screencast (no public)
#
# Stop the take with the bound key:  pkill -INT wf-recorder
# Output goes to ~/Videos/screencasts/; shared copy scp'd to burial /srv/www/share/screencasts/.

set -u

VIDDIR="$HOME/Videos/screencasts"
SHARE_PUBLIC="${SHARE_PUBLIC_URL:-https://share.glvortex.net/share}"
SHARE=1
MODE=region
for arg in "$@"; do
    case "$arg" in
        --local|--no-share) SHARE=0 ;;
        full|screen|output) MODE=full ;;
        window) MODE=window ;;
        region) MODE=region ;;
        *) echo "Unknown arg: $arg" >&2; exit 1 ;;
    esac
done
mkdir -p "$VIDDIR"
ID=$(date '+%Y%m%dT%H%M%S')
TMPVID="$VIDDIR/${ID}--screencast.mkv"
OUTJSON="$(mktemp)"

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
        sed -e 's/[^a-z0-9 -]//g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
            -e 's/[[:space:]]\+/-/g' -e 's/-\+/-/g'
}

note() { notify-send "Screen Record" "$1" 2>/dev/null || true; }
cleanup() {
    makoctl set-mode default 2>/dev/null || true
    rm -f "$OUTJSON"
}
trap cleanup EXIT INT TERM

# Compute the focused window's logical rect from niri IPC. Prints "x,y WxH" or nothing.
focused_window_rect() {
    niri msg -j focused-output > "$OUTJSON" 2>/dev/null || return 0
    niri msg -j windows 2>/dev/null | jq -r --slurpfile o "$OUTJSON" '
        ($o[0].logical) as $L
        | .[] | select(.is_focused == true) | .layout as $l
        | select($l.tile_pos_in_workspace_view != null)
        | ($L.x + $l.tile_pos_in_workspace_view[0] + ($l.window_offset_in_tile[0] // 0)) as $x
        | ($L.y + $l.tile_pos_in_workspace_view[1] + ($l.window_offset_in_tile[1] // 0)) as $y
        | "\($x|floor),\($y|floor) \($l.window_size[0]|floor)x\($l.window_size[1]|floor)"
    ' 2>/dev/null
}

GEO=""
OUTPUT=""
case "$MODE" in
    full|screen|output)
        OUTPUT=$(niri msg -j focused-output 2>/dev/null | jq -r '.name')
        ;;
    window)
        GEO=$(focused_window_rect)
        if [ -z "$GEO" ]; then
            note "Window geometry unavailable — select a region."
            GEO=$(slurp 2>/dev/null) || GEO=""
        fi
        ;;
    *)  # region (default)
        GEO=$(slurp 2>/dev/null) || GEO=""
        ;;
esac

# Pause notifications while recording (mako); restored by the EXIT trap.
makoctl set-mode do-not-disturb 2>/dev/null || true

# Hardware (VAAPI) encoding so capture keeps up at full resolution — software
# x264 was dropping to ~11fps. Override with WF_CODEC / WF_DEVICE if needed.
WF_CODEC="${WF_CODEC:-h264_vaapi}"
WF_DEVICE="${WF_DEVICE:-/dev/dri/renderD128}"

note "Recording — stop with the stop key (Mod+Shift+T)."
if [ -n "$OUTPUT" ]; then
    wf-recorder -c "$WF_CODEC" -d "$WF_DEVICE" -o "$OUTPUT" -f "$TMPVID"
elif [ -n "$GEO" ]; then
    wf-recorder -c "$WF_CODEC" -d "$WF_DEVICE" -g "$GEO" -f "$TMPVID"
else
    note "Cancelled."
    exit 0
fi

# wf-recorder exits when stopped (SIGINT from the stop-bind).
[ -s "$TMPVID" ] || { note "Nothing recorded."; exit 0; }

if ! title=$(fuzzel -d --prompt-only 'Screencast title: '); then
    note "Share canceled, kept $(basename "$TMPVID")"
    exit 0
fi
title=${title:-screencast}
slug=$(slugify "$title")
slug=${slug:-screencast}
STEM="${ID}--${slug}__screencast"
[ "$SHARE" -eq 1 ] && STEM="${STEM}_public"
dest="$VIDDIR/${STEM}.mkv"
mv "$TMPVID" "$dest"
TMPVID=$dest
OUTWEBM="$VIDDIR/${STEM}.webm"

note "Converting to webm…"
FPS="${RECORD_FPS:-30}"
WIDTH="${RECORD_WIDTH:-1280}"
if ! ffmpeg -y -vaapi_device /dev/dri/renderD128 -i "$TMPVID" \
        -vf "fps=${FPS},scale=w='min(${WIDTH},iw)':h=-2:flags=lanczos,format=nv12,hwupload" \
        -c:v av1_vaapi -an "$OUTWEBM" >/dev/null 2>&1; then
    note "ffmpeg failed; raw video kept at $TMPVID"
    exit 1
fi

if [ "$SHARE" -eq 0 ]; then
    note "Done (local): $OUTWEBM"
    exit 0
fi

chmod 644 "$OUTWEBM"
mkdir -p "$HOME/stash/share/screencasts"
cp "$OUTWEBM" "$HOME/stash/share/screencasts/${STEM}.webm"

if ! scp "$OUTWEBM" "burial:/srv/www/share/screencasts/${STEM}.webm"; then
    note "scp to burial failed; kept $OUTWEBM"
    exit 1
fi

URL="$SHARE_PUBLIC/screencasts/${STEM}.webm"
printf '%s' "$URL" | wl-copy
note "URL copied: $URL"
