#!/usr/bin/env bash
# record-sway — capture a screencast via wf-recorder, transcode to AV1
# webm, scp to burial /srv/www/share/screencasts (nginx /share/).
# mkv + webm both land in ~/Videos/screencasts/.
#
# Usage:
#   record-sway              # interactive region (slurp), upload + copy URL
#   record-sway window       # focused window rect (sway only;
#                            # niri/unknown falls back to slurp)
#   record-sway --local      # skip upload — local file only
#   record-sway --local window
#
# Stop the take with the bound key (pkill -INT wf-recorder).

set -euo pipefail

ARCHIVE_DIR="${RECORD_ARCHIVE_DIR:-$HOME/Videos/screencasts}"
SHARE_PUBLIC="${SHARE_PUBLIC_URL:-https://share.glvortex.net/share}"

SHARE=1
MODE=region
for arg in "$@"; do
    case "$arg" in
        --local|--no-share) SHARE=0 ;;
        window)             MODE=window ;;
        *) echo "Unknown arg: $arg" >&2; exit 1 ;;
    esac
done

mkdir -p "$ARCHIVE_DIR"
ID=$(date '+%Y%m%dT%H%M%S')
MKV="$ARCHIVE_DIR/${ID}--screencast.mkv"

slugify() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
        sed -e 's/[^a-z0-9 -]//g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
            -e 's/[[:space:]]\+/-/g' -e 's/-\+/-/g'
}

focused_rect_sway() {
    [ -n "${SWAYSOCK:-}" ] || return 0
    command -v swaymsg >/dev/null 2>&1 || return 0
    swaymsg -t get_tree 2>/dev/null \
        | jq -r '.. | select(.focused? == true) | .rect
                 | "\(.x),\(.y) \(.width)x\(.height)"'
}

if [ "$MODE" = window ]; then
    RECT=$(focused_rect_sway)
    if [ -z "$RECT" ]; then
        notify-send "Screen Record" \
            "No focused-window rect (niri or unknown compositor); region select."
        RECT=$(slurp)
    fi
else
    RECT=$(slurp)
fi

notify-send -t 1000 "Screen Record" "Recording"
sleep 1

# Restore mako on any exit (incl. SIGINT from the stop-bind).
trap 'makoctl set-mode default 2>/dev/null || true' EXIT INT TERM
makoctl set-mode do-not-disturb 2>/dev/null || true

wf-recorder -g "$RECT" -f "$MKV"

if ! title=$(fuzzel -d --prompt-only 'Screencast title: '); then
    notify-send "Share canceled" "kept $(basename "$MKV")"
    exit 0
fi
title=${title:-screencast}
slug=$(slugify "$title")
slug=${slug:-screencast}

if [ "$SHARE" -eq 1 ]; then
    STEM="${ID}--${slug}__screencast_public"
else
    STEM="${ID}--${slug}__screencast"
fi
dest="$ARCHIVE_DIR/${STEM}.mkv"
mv "$MKV" "$dest"
MKV=$dest
WEBM="$ARCHIVE_DIR/${STEM}.webm"

notify-send "Screen Record" "Converting to webm..."
ffmpeg -y -vaapi_device /dev/dri/renderD128 -i "$MKV" \
    -vf "fps=30,scale=w='min(1280,iw)':h=-2:flags=lanczos,format=nv12,hwupload" \
    -c:v av1_vaapi -an "$WEBM"

if [ "$SHARE" -eq 0 ]; then
    notify-send "Screen Record" "Done (local): $WEBM"
    exit 0
fi

chmod 644 "$WEBM"
mkdir -p "$HOME/stash/share/screencasts"
cp "$WEBM" "$HOME/stash/share/screencasts/${STEM}.webm"

if ! scp "$WEBM" "burial:/srv/www/share/screencasts/${STEM}.webm"; then
    notify-send "Share failed" "scp to burial failed"
    exit 1
fi

URL="$SHARE_PUBLIC/screencasts/${STEM}.webm"
printf '%s' "$URL" | wl-copy
notify-send "URL copied" "$URL"
