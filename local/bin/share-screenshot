#!/usr/bin/env bash
# share-screenshot — capture, resize via vips, scp to burial stash/share/screenshots
# (nginx /f/). Local PNG stays in Pictures/screenshots.
# Uses grimshot on Wayland and scrot+xdotool on X11.
#
# Usage:   share-screenshot [mode] [edit] [--local]
# Modes:   anything (default) | active | area | output | window
# Edit:    pass `edit' to crop/redact in satty before sharing;
#          quitting satty without saving cancels the share.
# --local: no scp; filename is ID--title__screenshot (no public).

set -euo pipefail

ARCHIVE_DIR="${SHARE_ARCHIVE_DIR:-$HOME/Pictures/screenshots}"
SHARE=1
MODE=anything
EDIT_MODE=
for arg in "$@"; do
  case "$arg" in
    --local|--no-share) SHARE=0 ;;
    edit) EDIT_MODE=edit ;;
    anything|active|area|output|window) MODE=$arg ;;
    *) echo "Unknown arg: $arg" >&2; exit 1 ;;
  esac
done

mkdir -p "$ARCHIVE_DIR"

ID=$(date '+%Y%m%dT%H%M%S')
slug=screenshot
PNG="$ARCHIVE_DIR/${ID}--${slug}.png"

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed -e 's/[^a-z0-9 -]//g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        -e 's/[[:space:]]\+/-/g' -e 's/-\+/-/g'
}

capture_x11() {
  local out="$1"
  case "$MODE" in
    anything|area|window)
      # scrot -s: drag → region, click → window.  -f freezes the screen.
      scrot --select --freeze --overwrite "$out"
      ;;
    active)
      scrot --focused --overwrite "$out"
      ;;
    output)
      # Find which xrandr output contains the cursor, capture that geometry.
      local X Y SCREEN WINDOW geom
      eval "$(xdotool getmouselocation --shell)"
      geom=$(xrandr --query | awk -v cx="$X" -v cy="$Y" '
        / connected/ {
          for (i = 3; i <= NF; i++) {
            if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
              split($i, a, /[x+]/)
              if (cx >= a[3] && cx < a[3] + a[1] && cy >= a[4] && cy < a[4] + a[2]) {
                printf "%d,%d,%d,%d", a[3], a[4], a[1], a[2]
                exit
              }
              break
            }
          }
        }')
      [[ -n $geom ]] || { notify-send "Couldn't determine output under cursor"; return 1; }
      scrot --autoselect "$geom" --overwrite "$out"
      ;;
    *)
      notify-send "Unknown screenshot mode: $MODE"
      return 1
      ;;
  esac
}

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  if ! grimshot save "$MODE" "$PNG"; then
    notify-send "Screenshot canceled"
    exit 0
  fi
  copy_url() { wl-copy; }
else
  if ! capture_x11 "$PNG"; then
    notify-send "Screenshot canceled"
    exit 0
  fi
  copy_url() { xclip -selection clipboard -i; }
fi

# Optional interactive crop/redact in satty before sharing.  satty only
# writes __edited.png on a save action, so quitting without saving
# leaves it absent → cancel the share.  (The raw capture stays in the
# local archive.)
if [[ "$EDIT_MODE" == edit ]]; then
  EDITED="${PNG%.png}__edited.png"
  # `--default-fill-shapes' makes the rectangle tool draw a SOLID opaque
  # box — the only safe way to redact secrets (blur/pixelate are
  # recoverable, e.g. via Depix).  Use rectangle for passwords; crop is
  # the startup tool for the common "keep this region" case.
  satty -f "$PNG" -o "$EDITED" --early-exit --initial-tool crop \
        --default-fill-shapes \
        --actions-on-enter save-to-file --actions-on-escape exit
  if [[ ! -f "$EDITED" ]]; then
    notify-send "Edit discarded — not shared"
    exit 0
  fi
  PNG="$EDITED"
fi

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  if ! title=$(fuzzel -d --prompt-only 'Screenshot title: '); then
    notify-send "Share canceled" "kept $(basename "$PNG")"
    exit 0
  fi
  title=${title:-screenshot}
  slug=$(slugify "$title")
  slug=${slug:-screenshot}
fi

STEM="${ID}--${slug}__screenshot"
[[ $SHARE -eq 1 ]] && STEM="${STEM}_public"
dest="$ARCHIVE_DIR/${STEM}.png"
if [[ "$PNG" != "$dest" ]]; then
  mv "$PNG" "$dest"
  PNG=$dest
fi

if [[ $SHARE -eq 0 ]]; then
  notify-send "Screenshot saved" "$(basename "$PNG")"
  exit 0
fi

WEBP=$(mktemp --suffix=.webp)
trap 'rm -f "$WEBP"' EXIT

vips thumbnail "$PNG" "${WEBP}[Q=80,strip]" 1920 --height 1200 --size down
chmod 644 "$WEBP"

if [[ -z ${SHARE_BASE_URL:-} ]]; then
  notify-send "Share failed" "SHARE_BASE_URL unset"
  exit 1
fi

if ! scp "$WEBP" "burial:stash/share/screenshots/${STEM}.webp"; then
  notify-send "Share failed" "scp to burial failed"
  exit 1
fi

URL="$SHARE_BASE_URL/f/screenshots/${STEM}.webp"
printf '%s' "$URL" | copy_url
notify-send "URL copied" "$URL"
