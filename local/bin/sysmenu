#!/bin/sh
# One popup for every system action, so none of them needs its own
# hard-to-remember chord. fuzzel prefix-matches, so this is leader plus
# one letter plus Enter in practice.
#
# A script rather than a sway `mode` because niri has no submaps -- the
# same binding has to work on both compositors.
#
# Every leaf shells out to the script that already owns that job; this
# file only routes. Existing chords are left alone: this is for
# discovering an action, not the fast path once you know it.

set -eu

# label \0 icon \037 name, per the dmenu icon protocol fuzzel speaks.
entry() { printf '%s\0icon\037%s\n' "$1" "$2"; }

# laptop-key drives the touchpad and panel through swaymsg, so those two
# rows only exist in a sway session. The label reflects current state.
if [ -n "${SWAYSOCK:-}" ]; then
	if swaymsg -t get_inputs -r \
		| jq -e 'any(.[]; .type == "touchpad" and .libinput.send_events == "enabled")' \
		>/dev/null; then
		touchpad_label='touchpad off'
		touchpad_icon=input-touchpad
	else
		touchpad_label='touchpad on'
		touchpad_icon=input-touchpad
	fi
fi

if systemctl --user is-active --quiet gammastep; then
	night_label='night light off'
else
	night_label='night light on'
fi

if [ "$(gsettings get org.gnome.desktop.interface color-scheme)" = "'prefer-dark'" ]; then
	dark_label='darkmode off'
else
	dark_label='darkmode on'
fi

if rfkill --raw --noheadings --output SOFT,HARD list wifi | grep -qw blocked; then
	airplane_label='airplane mode off'
else
	airplane_label='airplane mode on'
fi

menu() {
	entry 'audio output'    audio-speakers
	entry 'bluetooth'       preferences-system-bluetooth
	entry 'wifi'            network-wireless
	entry "$airplane_label"  transport-mode-flight
	entry 'display'         preferences-desktop-display-randr
	entry 'brightness min'  brightness-low
	entry 'brightness max'  brightness-high
	entry 'morning'          weather-clear
	entry 'evening'          weather-clear-night
	if [ -n "${SWAYSOCK:-}" ]; then
		entry 'screen off'      osd-shutd-screen
		entry "$touchpad_label" "$touchpad_icon"
	fi
	entry "$night_label"     weather-clear-night
	entry "$dark_label"      preferences-desktop-theme
	entry 'notifications'   preferences-desktop-notification
	entry 'screenshot'      applets-screenshooter
	entry 'record'          media-record
	entry 'battery profile' battery-profile-balanced
	entry 'power'           system-shutdown
}

case "$(menu | fuzzel --dmenu --prompt 'system ')" in
	'audio output')    audio-sink ;;
	bluetooth)         bluetooth-menu ;;
	wifi)              wifi-menu ;;
	'airplane mode off'|'airplane mode on') laptop-key airplane ;;
	display)           display-mode ;;
	'brightness min')  lightctl-osd set 1 ;;
	'brightness max')  lightctl-osd set 100 ;;
	morning)           display-preset morning ;;
	evening)           display-preset evening ;;
	'screen off')      laptop-key display ;;
	'touchpad off')    laptop-key touchpad-off ;;
	'touchpad on')     laptop-key touchpad-on ;;
	'night light off'|'night light on') ~/.config/waybar/scripts/gammastep.sh toggle ;;
	'darkmode off'|'darkmode on') toggle-darkmode ;;
	notifications)     notification-menu ;;
	screenshot)        screenshot-menu ;;
	record)            record-menu ;;
	'battery profile') tux-power-menu ;;
	power)             power-menu ;;
esac
