#!/usr/bin/env sh
# Waybar custom module (return-type json): NVIDIA GPU temperature.
# Text stays compact (temp°); the tooltip carries load, power draw and VRAM.

metrics=$(nvidia-smi \
	--query-gpu=temperature.gpu,utilization.gpu,power.draw,memory.used,memory.total \
	--format=csv,noheader,nounits 2>/dev/null) || metrics=

set -- $(printf '%s\n' "$metrics" | tr -d ',')

temp=$1 util=$2 power=$3 memused=$4 memtotal=$5

case "$temp" in
	""|*[!0-9]*)
	printf '{"text":"󰢮 n/a","tooltip":"nvidia-smi unavailable"}\n'
	exit 0
	;;
esac

# RTX 4090 targets/throttles ~84°C; warn early, red just below the throttle.
if [ "$temp" -ge 82 ]; then
	class=critical
elif [ "$temp" -ge 72 ]; then
	class=warning
else
	class=good
fi

printf '{"text":"󰢮 %s°","class":"%s","tooltip":"GPU  %s°C\\nLoad %s%%\\nPower %sW\\nVRAM %s / %s MiB"}\n' \
	"$temp" "$class" "$temp" "$util" "$power" "$memused" "$memtotal"
